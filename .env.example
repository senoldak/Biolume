# ==========================================
# BIOLUME CONFIGURATION
# ==========================================

# 1. Telegram Bot Settings (Obtain via @BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 2. Solana RPC & Wallet Settings (For Live Trading)
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_PRIVATE_KEY=
PAPER_TRADING=true

# 3. Automated Trading & Risk Parameters
DEFAULT_BUY_AMOUNT_SOL=0.2
MIN_LIQUIDITY_USD=3000
MAX_TOP10_HOLD_RATIO=0.35
MIN_SMART_MONEY_COUNT=2
MAX_DEV_HOLD_RATIO=0.05
SLIPPAGE_BPS=500

# 4. Automated Take Profit / Stop Loss (TP / SL)
AUTO_TP_PERCENT=50.0
AUTO_SL_PERCENT=20.0
TRAILING_STOP_ENABLED=true
